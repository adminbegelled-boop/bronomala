{
  "name": "firewell-monorepo",
  "version": "1.0.0",
  "description": "Firewell (Farewell) Registration Monorepo with Express, Next.js, and MongoDB",
  "main": "server/src/index.js",
  "scripts": {
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install",
    "install:all": "npm install && npm run install:server && npm run install:client",
    "build:client": "cd client && npm run build",
    "build": "npm run install:server && npm run install:client && npm run build:client",
    "start": "node server/src/index.js",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:client\""
  },
  "keywords": [
    "farewell",
    "firewell",
    "registration",
    "express",
    "nextjs",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
