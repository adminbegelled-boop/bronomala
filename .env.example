# Environment Configuration for Firewell Registration

# Server Port (Render automatically sets PORT)
PORT=5001

# MongoDB Connection String
# Replace with your MongoDB Atlas or local MongoDB URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/firewell?retryWrites=true&w=majority

# JWT Secret for Admin Authentication
JWT_SECRET=firewell_super_secret_jwt_key_change_in_production_2026

# Default Admin Credentials (automatically seeded if not present in DB)
ADMIN_NAME=Farewell Admin
ADMIN_EMAIL=admin@firewell.com
ADMIN_PASSWORD=admin123

# Node Environment
NODE_ENV=production
